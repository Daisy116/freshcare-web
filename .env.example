# Only public, non-sensitive frontend configuration belongs here.
VITE_PRODUCTS_SOURCE=mock
VITE_TICKET_API_MODE=mock
VITE_ADMIN_AUTH_MODE=mock
VITE_ADMIN_TICKETS_MODE=mock
# Set both admin modes to api locally to enable the Session-protected admin backend.
# VITE_ADMIN_AUTH_MODE=api
# VITE_ADMIN_TICKETS_MODE=api
# VITE_TICKET_API_URL=https://your-public-api.example.com

# Local admin Session API configuration (keep ADMIN_SESSION_SECRET private).
SESSION_API_PORT=3001
VITE_SESSION_API_PROXY_TARGET=http://127.0.0.1:3001
N8N_BASE_URL=http://localhost:5678
ADMIN_SESSION_DB_PATH=./data/admin-sessions.sqlite
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_APP_ORIGIN=http://localhost:5173
ADMIN_SESSION_HOST=127.0.0.1
# Set true only when the Session API is behind a trusted reverse proxy.
ADMIN_SESSION_TRUST_PROXY=false
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
